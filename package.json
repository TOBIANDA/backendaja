{
  "name": "backend-pmkdaniel",
  "version": "1.0.0",
  "description": "Cloudflare Workers + Hono Backend for PMK Daniel FILKOM UB",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply pmk-db --local",
    "migrate:remote": "wrangler d1 migrations apply pmk-db --remote",
    "seed:local": "wrangler d1 execute pmk-db --local --file=./migrations/0002_seed_data.sql",
    "seed:remote": "wrangler d1 execute pmk-db --remote --file=./migrations/0002_seed_data.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.109.2"
  }
}
